# 회사 메일 SMTP 설정 (이 파일을 mail.env 로 복사 후 값 입력)

# ── 네이버웍스(Works Mobile) 예시 ──
# SMTP 서버: smtp.worksmobile.com
# 포트: 587(STARTTLS) 또는 465(SSL)
# MAIL_USERNAME: 전체 메일주소 (예: pnsas@hyundaiwelding.com)
# MAIL_PASSWORD: 로그인 비밀번호가 아닌 「외부 앱 비밀번호」
#   → 웍스 메일 > 프로필 > 보안 > 외부 앱 비밀번호 생성
# Admin > 보안 > 서비스 권한에서 IMAP/SMTP 사용 허용 필요

MAIL_SERVER=smtp.worksmobile.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=pnsas@hyundaiwelding.com
MAIL_PASSWORD=여기에_외부앱비밀번호_입력
MAIL_FROM=HYUNDAI AS System <pnsas@hyundaiwelding.com>

# SSL(465) 사용 시:
# MAIL_PORT=465
# MAIL_USE_TLS=false
# MAIL_USE_SSL=true

MAIL_BASE_URL=http://43.201.229.107:5004
