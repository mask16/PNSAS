# 네이버웍스: MAIL_PASSWORD는 로그인 비밀번호가 아니라 「외부 앱 비밀번호」를 사용하세요.
# 웍스 메일 > 프로필 > 보안 > 외부 앱 비밀번호 생성
# Admin > 보안 > 서비스 권한 > 메일 IMAP/SMTP 사용 허용 확인
MAIL_SERVER=smtp.worksmobile.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=pnsas1@hyundaiwelding.com
MAIL_PASSWORD=pnsas1@123
MAIL_FROM=pnsas1@hyundaiwelding.com

# 이메일 본문 링크에 사용할 사이트 주소
MAIL_BASE_URL=http://43.201.229.107:5004
